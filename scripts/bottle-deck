#!/usr/bin/env bash
# bottle-deck — build and publish the prebuilt bottle for the deck formula
# and point the formula at it. Run AFTER Formula/deck.rb's tag:/version were
# bumped and pushed. deck is pure bash, so one bottle (tag "all") serves
# every macOS/arch; brew bottle only emits "all" on its own when two
# platforms agree, so the tag is written by hand here.
set -euo pipefail
tap_dir=$(cd "$(dirname "$0")/.." && pwd)
formula="$tap_dir/Formula/deck.rb"
version=$(sed -n 's/^  version "\(.*\)"/\1/p' "$formula")
[ -n "$version" ] || { echo "no version in $formula" >&2; exit 1; }
release="deck-$version"
root_url="https://github.com/lizarusi/homebrew-tap/releases/download/$release"
work=$(mktemp -d); trap 'rm -rf "$work"' EXIT
cd "$work"

# drop the previous version's bottle block first, or brew bottle numbers the
# new one as a rebuild of it instead of starting at 0
python3 - "$formula" <<'PY'
import re, sys
p = sys.argv[1]; s = open(p).read()
open(p, 'w').write(re.sub(r'  bottle do\n.*?\n  end\n\n?', '', s, count=1, flags=re.S))
PY
# a bottle must come from a --build-bottle install
brew uninstall deck >/dev/null 2>&1 || true
brew install --build-bottle lizarusi/tap/deck
brew bottle --json --root-url="$root_url" lizarusi/tap/deck >/dev/null
src=$(ls deck--"$version".*.bottle*.tar.gz)
rebuild=$(echo "$src" | sed -n 's/.*\.bottle\.\([0-9]*\)\.tar\.gz/\1/p'); rebuild=${rebuild:-0}
asset="deck-$version.all.bottle${rebuild:+.$rebuild}.tar.gz"; [ "$rebuild" = 0 ] && asset="deck-$version.all.bottle.tar.gz"
cp "$src" "$asset"
sha=$(shasum -a 256 "$asset" | cut -d' ' -f1)

gh release view "$release" --repo lizarusi/homebrew-tap >/dev/null 2>&1 \
  || gh release create "$release" --repo lizarusi/homebrew-tap --title "deck $version bottle" \
       --notes "Prebuilt bottle for the deck formula (pure bash, one file for every macOS/arch)." >/dev/null
gh release upload "$release" "$asset" --repo lizarusi/homebrew-tap --clobber >/dev/null

# (re)write the bottle block
python3 - "$formula" "$root_url" "$rebuild" "$sha" <<'PY'
import re, sys
p, root, rebuild, sha = sys.argv[1:]
s = open(p).read()
block = f'''  bottle do
    root_url "{root}"
{"    rebuild " + rebuild + chr(10) if rebuild != "0" else ""}    sha256 cellar: :any_skip_relocation, all: "{sha}"
  end
'''
if 'bottle do' in s:
    s = re.sub(r'  bottle do\n.*?\n  end\n', block, s, count=1, flags=re.S)
else:
    s = s.replace('  depends_on "fzf"\n', block + '\n  depends_on "fzf"\n', 1)
open(p, 'w').write(s)
PY
ruby -c "$formula" >/dev/null
git -C "$tap_dir" commit -qam "deck $version: bottle" && git -C "$tap_dir" push -q origin main
echo "bottle published: $root_url/$asset"
echo "verify on this machine: brew uninstall deck && brew install lizarusi/tap/deck   (expect 'Pouring $asset'), then deck setup"
